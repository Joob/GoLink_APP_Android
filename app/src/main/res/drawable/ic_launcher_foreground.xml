<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon foreground (also used by the splash, via
  @mipmap/ic_launcher, so the home icon and the startup icon are identical).
  108dp canvas. The logo is scaled (gravity="fill") to 32dp = ~30%, i.e. a
  small, fully-visible mark with generous padding. Keeping the logo small also
  minimises the launcher's built-in adaptive-icon zoom on open/close (the
  system briefly shows the inner ~2/3 of the foreground, which enlarges any
  centred content; a smaller logo makes that far less noticeable).
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item
        android:width="32dp"
        android:height="32dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/logo_symbol"
            android:gravity="fill" />
    </item>
</layer-list>
