<?xml version="1.0" encoding="utf-8"?>
<!--
  EXPERIMENT: non-adaptive launcher icon.
  A self-contained white circle + centred logo (NOT an <adaptive-icon>), so the
  launcher does not apply the adaptive-icon zoom/parallax animation that made
  the logo briefly grow on app open/close. To revert, restore the previous
  <adaptive-icon> referencing @drawable/ic_launcher_background + foreground.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
            <size android:width="108dp" android:height="108dp" />
        </shape>
    </item>
    <item
        android:width="36dp"
        android:height="36dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/logo_symbol"
            android:gravity="fill" />
    </item>
</layer-list>
