<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Recibos: ler o QR das faturas em direto (pedida só ao abrir o Scan). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lembretes do calendário: alarme exato quando o utilizador o permite (Android 14+
         vem negado por omissão); sem ele ficam aproximados. USE_EXACT_ALARM é só para
         apps cuja função principal é calendário/despertador (política do Google Play). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <!-- Auto-backup media access -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+: "Selecionar fotos" dá acesso parcial persistente; sem
         esta declaração fica em modo de compatibilidade (temporário) e o
         worker em background perdia o acesso. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- "Acesso a todos os ficheiros" (Android 11+): sem isto o MediaStore só
         devolve ficheiros multimédia a apps de terceiros, e o backup de
         Downloads/Documentos perde PDFs, ZIPs, etc. Concedido num ecrã do
         sistema, pedido ao activar essas fontes. Justificável na Play Store:
         a app é um gestor de ficheiros. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Foreground service so the backup worker survives Doze / background
         restrictions and the user sees an ongoing upload notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Pass/autofill: ver a assinatura dos browsers de confiança (PassTrustedBrowsers).
         Sem isto, no Android 11+ o pacote fica invisível e hasSigningCertificate dá false. -->
    <queries>
        <package android:name="com.android.chrome" />
        <package android:name="com.chrome.beta" />
        <package android:name="com.chrome.dev" />
        <package android:name="com.chrome.canary" />
        <package android:name="org.chromium.chrome" />
        <package android:name="com.google.android.apps.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="org.mozilla.firefox_beta" />
        <package android:name="org.mozilla.focus" />
        <package android:name="org.mozilla.fennec_aurora" />
        <package android:name="org.mozilla.rocket" />
        <package android:name="org.mozilla.fenix" />
        <package android:name="org.mozilla.focus.beta" />
        <package android:name="org.mozilla.focus.nightly" />
        <package android:name="org.mozilla.klar" />
        <package android:name="com.microsoft.emmx.canary" />
        <package android:name="com.microsoft.emmx.dev" />
        <package android:name="com.microsoft.emmx.beta" />
        <package android:name="com.microsoft.emmx" />
        <package android:name="com.brave.browser" />
        <package android:name="com.brave.browser_beta" />
        <package android:name="com.brave.browser_nightly" />
        <package android:name="app.vanadium.browser" />
        <package android:name="com.vivaldi.browser" />
        <package android:name="com.vivaldi.browser.snapshot" />
        <package android:name="com.vivaldi.browser.sopranos" />
        <package android:name="com.android.browser" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.sec.android.app.sbrowser.beta" />
        <package android:name="com.yandex.browser" />
        <package android:name="com.yandex.browser.beta" />
        <package android:name="com.yandex.browser.alpha" />
        <package android:name="com.yandex.browser.corp" />
        <package android:name="com.yandex.browser.canary" />
        <package android:name="com.yandex.browser.broteam" />
        <package android:name="com.talonsec.talon" />
        <package android:name="com.talonsec.talon_beta" />
        <package android:name="com.talonsec.intune.talon" />
        <package android:name="com.duckduckgo.mobile.android" />
        <package android:name="com.naver.whale" />
        <package android:name="com.heytap.browser" />
        <package android:name="io.island.Island" />
        <package android:name="io.island.IslandCanary" />
        <package android:name="io.island.IslandBeta" />
        <package android:name="io.island.IslandDev" />
        <package android:name="io.island.island.intune" />
        <package android:name="io.island.island.canary.intune" />
        <package android:name="io.island.island.beta.intune" />
        <package android:name="io.island.island.dev.intune" />
        <package android:name="net.quetta.browser" />
        <package android:name="cz.seznam.sbrowser" />
        <package android:name="com.opera.mini.native" />
        <package android:name="com.opera.mini.native.beta" />
        <package android:name="com.zoho.primeum.stable" />
        <package android:name="ai.perplexity.comet" />
        <package android:name="com.amazon.cloud9" />
        <package android:name="net.waterfox.android.release" />
        <package android:name="com.opera.browser" />
        <package android:name="com.opera.browser.beta" />
        <package android:name="com.wsapp.browser" />
        <package android:name="io.github.jqssun.helium" />
        <package android:name="com.norton.neo" />
        <package android:name="com.netskope.browser" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VueFileManager"
        tools:targetApi="31">
        <!-- requestLegacyExternalStorage: ignorado a partir do Android 11, mas no 10
             (minSdk 26) é o que deixa o backup ver Downloads/Documentos (sem
             MANAGE_EXTERNAL_STORAGE nessa versão). -->

        <!-- Câmara do "+": fotos/vídeos gravados na cache antes do envio. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Pass: preenchimento de logins noutras apps e no browser. -->
        <service
            android:name=".data.pass.autofill.PassAutofillService"
            android:exported="true"
            android:label="@string/pass_autofill_label"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/pass_autofill_service" />
        </service>
        <activity
            android:name=".ui.screens.pass.autofill.PassAutofillActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.VueFileManager" />

        <!-- Login social (Custom Tabs): regresso <applicationId>.oauth:/callback?code&state. -->
        <activity
            android:name=".ui.screens.socialite.OAuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}.oauth" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|uiMode|keyboard|keyboardHidden|navigation"
            android:theme="@style/Theme.VueFileManager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: abrir na app os links de reposição de password e de
                 convite enviados por email (create-new-password / register/{token}).
                 Requer assetlinks.json em /.well-known/ de cada domínio. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="golink.co" />
                <!-- ${appLinkAltHost}: tester.golink.co só no debug (dá 403 ao assetlinks e,
                     em Android ≤ 11, um host sem verificar anula a verificação de todos). -->
                <data android:host="${appLinkAltHost}" />
                <data android:pathPrefix="/create-new-password" />
                <data android:pathPrefix="/register/" />
                <!-- Legacy: abrir cofre (recipient), convite de guardião, check-in do email. -->
                <data android:pathPrefix="/legacy-open/" />
                <data android:pathPrefix="/legacy-invite/" />
                <data android:pathPrefix="/legacy-checkin/" />
            </intent-filter>
            <!-- Links dos emails com ecrã na app (AppLinkRouter): confirmar email,
                 convite de equipa, pastas, calendário, suporte, faturação, Legacy.
                 /share, /request e /event-invite ficam no browser (públicos, #k=). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="golink.co" />
                <!-- ${appLinkAltHost}: tester.golink.co só no debug (dá 403 ao assetlinks e,
                     em Android ≤ 11, um host sem verificar anula a verificação de todos). -->
                <data android:host="${appLinkAltHost}" />
                <data android:pathPrefix="/api/user/verify/" />
                <data android:pathPrefix="/team-folder-invitation/" />
                <!-- path + pathPrefix com "/": "/calendarX" ou "/platform/files-…" ficam no
                     browser em vez de abrir a app e o link se perder (AppLinkRouter). -->
                <data android:path="/platform/files" />
                <data android:pathPrefix="/platform/files/" />
                <data android:path="/platform/team-folders" />
                <data android:pathPrefix="/platform/team-folders/" />
                <data android:path="/calendar" />
                <data android:pathPrefix="/calendar/" />
                <data android:path="/notes" />
                <data android:pathPrefix="/notes/" />
                <data android:pathPrefix="/support/tickets/" />
                <data android:pathPrefix="/admin/support/tickets/" />
                <data android:path="/user/settings/billing" />
                <data android:pathPrefix="/user/settings/billing/" />
                <data android:path="/legacy" />
                <data android:pathPrefix="/legacy/" />
                <!-- Pass: o email de conta inativa leva a /pass/settings (exportar). -->
                <data android:path="/pass" />
                <data android:pathPrefix="/pass/" />
            </intent-filter>
        </activity>

        <!--
            WorkManager 2.10.0 declares SystemForegroundService without a
            foregroundServiceType, which is mandatory on Android 14+ — the
            framework throws MissingForegroundServiceTypeException synchronously
            from setForeground(), crashing the worker process. We merge the
            attribute in so the FGS is allowed to start as a data-sync service.
        -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Transferências (ficheiros e zips): mantém o processo vivo e a
             notificação de progresso (%) enquanto descarrega/decifra. -->
        <service
            android:name="co.golink.tester.data.download.ZipDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Lembretes do calendário: dispara e reagenda depois de reiniciar/atualizar. -->
        <receiver
            android:name="co.golink.tester.data.calendar.CalendarAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
                <!-- Fuso/hora mudaram: dias inteiros e "Hoje/Amanhã" voltam a ser calculados. -->
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
