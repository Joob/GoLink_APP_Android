{
    "_doc": "Casos partilhados do Evento rápido (JS ⇄ Kotlin). now = data/hora local (2026-11-02 é segunda). Em expect só se comparam os campos indicados; repeat = {repeat, interval, days}. Verificar com: node ops/calendar/fixtures.mjs",
    "now": "2026-11-02T10:00",
    "calendars": [{ "id": "p", "name": "Personal" }, { "id": "w", "name": "Work" }, { "id": "f", "name": "Família" }],
    "defaultCalendarId": "p",
    "selfEmail": "me@golink.co",
    "cases": [
        { "locale": "pt", "text": "Jantar amanhã às 20h @Porto #família", "expect": { "ok": true, "title": "Jantar", "location": "Porto", "calendarId": "f", "startDay": "2026-11-03", "startTime": "20:00", "endTime": "21:00" } },
        { "locale": "pt", "text": "Aniversário da Ana no dia 2 de fevereiro de 2027", "expect": { "title": "Aniversário da Ana", "startDay": "2027-02-02", "allDay": true } },
        { "locale": "pt", "text": "Dentista sexta 9:30 #personal", "expect": { "title": "Dentista", "calendarId": "p", "startDay": "2026-11-06", "startTime": "09:30", "endTime": "10:30" } },
        { "locale": "pt", "text": "Jantar 2 dez 20h30", "expect": { "title": "Jantar", "startDay": "2026-12-02", "startTime": "20:30", "endTime": "21:30" } },
        { "locale": "pt", "text": "Voo para Paris dia 10/12 às 6:45 #work", "expect": { "title": "Voo para Paris", "calendarId": "w", "startDay": "2026-12-10", "startTime": "06:45" } },
        { "locale": "pt", "text": "Mar e sol domingo", "expect": { "title": "Mar e sol", "startDay": "2026-11-08", "allDay": true } },
        { "locale": "en", "text": "Lunch with John tomorrow 13h @Cais #fam", "expect": { "title": "Lunch with John", "location": "Cais", "calendarId": "f", "startDay": "2026-11-03", "startTime": "13:00", "endTime": "14:00" } },
        { "locale": "en", "text": "Apple WWDC Event on 7th June 2021", "expect": { "title": "Apple WWDC Event", "startDay": "2021-06-07" } },
        { "locale": "en", "text": "Meeting from 2pm to 4pm on March 5", "expect": { "title": "Meeting", "startDay": "2027-03-05", "startTime": "14:00", "endTime": "16:00" } },
        { "locale": "en", "text": "Meeting Dec 5 at 10am", "expect": { "title": "Meeting", "startDay": "2026-12-05", "startTime": "10:00" } },
        { "locale": "en", "text": "Call tomorrow 3pm for 30 min", "expect": { "title": "Call", "startDay": "2026-11-03", "startTime": "15:00", "endTime": "15:30", "alerts": null } },
        { "locale": "en", "text": "Standup Monday 9:15 - 9:30", "expect": { "title": "Standup", "startDay": "2026-11-09", "startTime": "09:15", "endTime": "09:30" } },
        { "locale": "en", "text": "Party 2027-01-01 22:00", "expect": { "title": "Party", "startDay": "2027-01-01", "startTime": "22:00" } },
        { "locale": "en", "text": "Gym tomorrow 7am #sport", "expect": { "calendarId": "p", "unknownTag": "sport" } },
        { "locale": "de", "text": "Treffen am 5. März um 13 Uhr", "expect": { "title": "Treffen", "startDay": "2027-03-05", "startTime": "13:00" } },
        { "locale": "de", "text": "Arzt morgen 14:30", "expect": { "title": "Arzt", "startDay": "2026-11-03", "startTime": "14:30" } },
        { "locale": "fr", "text": "Dîner le 14 juillet à 20h", "expect": { "title": "Dîner", "startDay": "2027-07-14", "startTime": "20:00" } },
        { "locale": "es", "text": "Cena el 3 de diciembre a las 21:00", "expect": { "title": "Cena", "startDay": "2026-12-03", "startTime": "21:00" } },
        { "locale": "pt", "text": "Geburtstag 2. Februar", "expect": { "title": "Geburtstag", "startDay": "2027-02-02" } },
        { "locale": "pt", "text": "  ", "expect": { "ok": false, "error": "empty" } },
        { "locale": "pt", "text": "Reunião", "expect": { "error": "no_date" } },
        { "locale": "en", "text": "Call with team at 3pm for 30 min", "expect": { "error": "no_date" } },
        { "locale": "pt", "text": "Reunião em março", "expect": { "error": "no_day" } },
        { "locale": "pt", "text": "Dia 30 de fevereiro festa", "expect": { "error": "invalid_date" } },
        { "locale": "pt", "text": "amanhã 13h", "expect": { "ok": false, "error": "no_title" } },

        { "locale": "pt", "text": "Férias de 1 a 7 de fevereiro", "expect": { "title": "Férias", "startDay": "2027-02-01", "endDay": "2027-02-07" } },
        { "locale": "pt", "text": "Férias 1-7 fevereiro", "expect": { "title": "Férias", "startDay": "2027-02-01", "endDay": "2027-02-07" } },
        { "locale": "en", "text": "Vacation Feb 1 to Feb 7", "expect": { "title": "Vacation", "startDay": "2027-02-01", "endDay": "2027-02-07" } },
        { "locale": "en", "text": "Vacation February 1st to 7th", "expect": { "title": "Vacation", "startDay": "2027-02-01", "endDay": "2027-02-07" } },
        { "locale": "fr", "text": "Vacances du 1er au 7 février", "expect": { "title": "Vacances", "startDay": "2027-02-01", "endDay": "2027-02-07" } },
        { "locale": "es", "text": "Vacaciones del 1 al 7 de febrero", "expect": { "title": "Vacaciones", "startDay": "2027-02-01", "endDay": "2027-02-07" } },
        { "locale": "pt", "text": "Viagem 28 de dezembro a 3 de janeiro", "expect": { "startDay": "2026-12-28", "endDay": "2027-01-03" } },
        { "locale": "pt", "text": "Feira 1 a 7 de novembro", "expect": { "startDay": "2026-11-01", "endDay": "2026-11-07" } },
        { "locale": "pt", "text": "Congresso 1 fev 10h a 3 fev 18h", "expect": { "title": "Congresso", "startDay": "2027-02-01", "startTime": "10:00", "endDay": "2027-02-03", "endTime": "18:00" } },
        { "locale": "en", "text": "Party 1st of March", "expect": { "startDay": "2027-03-01", "endDay": "2027-03-01" } },

        { "locale": "pt", "text": "Reunião amanhã 15h com ana@x.com e me@golink.co @Cais #work // levar o portátil", "expect": { "ok": true, "title": "Reunião", "location": "Cais", "calendarId": "w", "guests": ["ana@x.com"], "notes": "levar o portátil" } },

        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Ginásio todas as segundas e quartas 7h 10 min antes", "expect": { "title": "Ginásio", "repeat": { "repeat": "weekly", "interval": 1, "days": [1, 3] }, "startDay": "2026-11-04", "alerts": [10] } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Comprimido todos os dias 9h", "expect": { "repeat": { "repeat": "daily", "interval": 1, "days": [] }, "startDay": "2026-11-03" } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Renda todos os meses 9h", "expect": { "startDay": "2026-12-02" } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Comprimido todos os dias 21h", "expect": { "startDay": "2026-11-02" } },
        { "locale": "es", "now": "2026-11-02T11:00", "text": "Gimnasio todos los lunes 7h", "expect": { "title": "Gimnasio", "repeat": { "repeat": "weekly", "interval": 1, "days": [1] } } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Standup dias úteis 9:30", "expect": { "repeat": { "repeat": "weekly", "interval": 1, "days": [1, 2, 3, 4, 5] } } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Renda a cada 2 meses dia 5 de dezembro", "expect": { "repeat": { "repeat": "monthly", "interval": 2, "days": [] } } },
        { "locale": "en", "now": "2026-11-02T11:00", "text": "Gym every Monday 7am", "expect": { "repeat": { "repeat": "weekly", "interval": 1, "days": [1] } } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Aula todas as terças até 30 de junho 18h", "expect": { "title": "Aula", "startDay": "2026-11-03", "repeatUntil": "2027-06-30" } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Aulas todas as quintas de 1 de fevereiro a 30 de junho 10h", "expect": { "startDay": "2027-02-04", "endDay": "2027-02-04", "repeatUntil": "2027-06-30" } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Reunião segunda às 10h", "expect": { "repeat": null } },

        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Chamada amanhã 15h 1 dia antes 1 h antes", "expect": { "alerts": [60, 1440], "endTime": "16:00" } },
        { "locale": "en", "now": "2026-11-02T11:00", "text": "Gym tomorrow 7am remind me 1 hour before", "expect": { "alerts": [60] } },
        { "locale": "pt", "now": "2026-11-02T11:00", "text": "Jantar amanhã 20h antes do cinema", "expect": { "alerts": null, "startTime": "20:00" } },
        { "locale": "en", "now": "2026-11-02T11:00", "text": "Gym tomorrow 7am remind me 1h before", "expect": { "alerts": [60] } },

        { "locale": "pt", "text": "Almoço com a Marta 5 de maio", "expect": { "title": "Almoço com a Marta", "startDay": "2027-05-05" } },
        { "locale": "pt", "text": "Jantar com a Marta", "expect": { "error": "no_date" } },
        { "locale": "pt", "text": "Reunião amanhã às 10 horas durante 30 min", "expect": { "title": "Reunião", "startTime": "10:00", "endTime": "10:30" } },
        { "locale": "pt", "text": "Reunião amanhã às 10.30.", "expect": { "startDay": "2026-11-03", "startTime": "10:30" } },
        { "locale": "pt", "text": "Jantar amanhã @Avenida 5 de Outubro", "expect": { "startDay": "2026-11-03", "location": "Avenida 5 de Outubro" } },
        { "locale": "pt", "text": "Jantar @Cais amanhã 13h", "expect": { "location": "Cais" } },
        { "locale": "pt", "text": "Aniversário 29 fevereiro", "expect": { "startDay": "2028-02-29" } }
    ]
}
